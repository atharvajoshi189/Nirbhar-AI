# ==============================================================================
# AgentTrust AI — Environment Configuration Example
# Copy this file to .env and populate with real sandbox and API keys.
# ==============================================================================

# Core Services
API_PORT=8000
API_BASE_URL=http://localhost:8000
VENDOR_GATEWAY_PORT=8001
VENDOR_GATEWAY_URL=http://localhost:8001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Gemini API
# Required for agent orchestration, planning, and evaluation
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Supabase (Database, Auth, Realtime)
# Required for persistent records, audit trail, and realtime updates
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# PayPal Sandbox REST API (v2)
# Required for real payment authorization and capture
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here

# Tavily Search API
# Required for real web search and external vendor quote retrieval
TAVILY_API_KEY=your_tavily_api_key_here

# Redis & Job Queue
REDIS_URL=redis://localhost:6379/0

# App Security
JWT_SECRET=generate_a_random_32_character_secret_here
TRUST_ENGINE_STRICT_MODE=true

