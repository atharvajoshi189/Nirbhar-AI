# ==============================================================================
# Nirbhar AI — Environment Configuration Template
# Copy this file to .env and populate with real sandbox and API keys.
# DO NOT commit real secrets to this file.
# ==============================================================================

# Core Services
API_PORT=8000
API_BASE_URL=http://localhost:8000
VENDOR_GATEWAY_PORT=8001
VENDOR_GATEWAY_URL=http://localhost:8001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Supabase (Database, Auth, Realtime)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# PayPal Sandbox REST API (v2)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here

# Tavily Search API
TAVILY_API_KEY=your_tavily_api_key_here

# Redis & Job Queue
REDIS_URL=redis://localhost:6379/0

# App Security & Policy
JWT_SECRET=your_jwt_secret_32_characters_here
AUDIT_SECRET=your_audit_secret_hash_salt_here
TRUST_ENGINE_STRICT_MODE=true

# Observability & Production Resilience (Phase 8)
RATE_LIMIT_PER_MINUTE=240
IDEMPOTENCY_TTL_SECONDS=86400
SENTRY_DSN=your_sentry_dsn_here

# Vendor Gateway HMAC Quote Signing
QUOTE_HMAC_SECRET=your_quote_hmac_secret_here
